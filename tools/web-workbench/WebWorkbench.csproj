<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>2.14.1</Version>
    <OutputType>WinExe</OutputType>
    <AssemblyName>网页汉化工作台</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <DefineConstants>$(DefineConstants);WEB_WORKBENCH</DefineConstants>
    <!-- Shared models also have fields populated exclusively by the game plugin. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../Dependencies/Newtonsoft.Json/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Compile Include="../../src/Workbench/WebWorkbenchFiles.cs;../../src/Localization/LocalizationModels.cs;../../src/Translation/TranslationClients.cs;../../src/Translation/TranslationSafety.cs;../../src/Translation/AiExecutionOptions.cs" />
    <Compile Include="../../src/Workbench/GlossaryEditorSession.cs;../../src/Localization/TranslationTracking.cs" />
    <EmbeddedResource Include="../glossary-editor/glossary-editor.js" LogicalName="GlossaryEditorScript" />
    <Compile Include="../../Shared/GlossaryDocument.cs;../../Shared/TranslationGlossary.cs;../../Shared/AiModelCatalog.cs;../../Shared/TranslationProviderPresets.cs;../../Shared/TranslationRequestPolicy.cs;../../Shared/BoundedHttpContent.cs;../../Shared/PaidApiBudget.cs" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CreateStandaloneLauncher" AfterTargets="Publish" DependsOnTargets="_GetAppHostPaths"
          Condition="'$(PublishStandaloneLauncher)' == 'true'">
    <MakeDir Directories="$(PublishDir)launcher" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PublishDir)launcher/网页汉化工作台.exe"
                   AppBinaryName="网页汉化工作台\网页汉化工作台.dll"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true" />
  </Target>
</Project>
