    <Compile Include="Shared\GlossaryDocument.cs" />
    <Compile Include="src\Integration\LiveSyncLogFilter.cs" />
    <Compile Include="Shared\TranslationGlossary.cs" />
    <Compile Include="src\Translation\AiModelSelection.cs" />
    <Compile Include="Shared\AiModelCatalog.cs" />
    <Compile Include="Shared\TranslationProviderPresets.cs" />
