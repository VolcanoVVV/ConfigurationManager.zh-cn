    <Compile Include="src\Workbench\TranslationPanel.cs" />
    <Compile Include="src\Workbench\TranslationPanel.PluginSelection.cs" />
    <Compile Include="src\Workbench\WebWorkbenchFiles.cs" />
    <Compile Include="src\Workbench\WebWorkbenchBridge.cs" />
    <Compile Include="src\Workbench\TranslationPanelTheme.cs" />
    <Compile Include="src\Translation\TranslationSafety.cs" />
    <Compile Include="src\Localization\TranslationTracking.cs" />
